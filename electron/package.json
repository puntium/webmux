{
  "name": "webmux-client",
  "version": "0.11.0",
  "private": true,
  "description": "macOS Electron client for webmux, connected over a supervised SSH tunnel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac zip --arm64"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "me.puntium.webmux",
    "productName": "webmux",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "deploy.js",
      "platforms.js",
      "connect.html",
      "header.html",
      "ui/**/*",
      "payload/payload.tar.gz",
      "payload/payload.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  }
}
