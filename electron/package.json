{
  "name": "webmux-client",
  "version": "0.21.3",
  "private": true,
  "description": "macOS Electron client for webmux, connected over a supervised SSH tunnel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir --arm64 && node pack-mac.js dist/mac-arm64/webmux.app dist/webmux-$npm_package_version-arm64-mac.zip mac-sign.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "me.puntium.webmux",
    "productName": "webmux",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "log.js",
      "deploy.js",
      "lan.js",
      "platforms.js",
      "connect.html",
      "header.html",
      "logs.html",
      "ui/**/*",
      "payload/payload.tar.gz",
      "payload/payload.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "webmux connects to hosts on your local network over ssh."
      }
    }
  }
}
