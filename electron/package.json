{
  "name": "webmux-client",
  "version": "0.4.0",
  "private": true,
  "description": "macOS Electron client for webmux, connected over a supervised SSH tunnel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac zip --arm64"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "me.puntium.webmux",
    "productName": "webmux",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "connect.html"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  }
}
