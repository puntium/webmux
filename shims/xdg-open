#!/bin/sh
# webmux xdg-open shim — no browser exists on this headless host, so instead
# of opening anything, forward the URL to the attached webmux client: drop a
# spool file into $WEBMUX_CLIPBOARD_DIR (shared with the webmux server),
# which the server watches and relays to the browser client as an 'open-url'
# message. The client then shows the same open/copy chooser as a clicked
# terminal URL, and "Open" lands in the client machine's browser.
# WEBMUX_SESSION (exported by the pty host) routes the URL to the client
# viewing this session; without it the server broadcasts.

case "$1" in
  http://*|https://*) ;;
  *) exit 4 ;; # xdg-open's "action failed" — local files can't open remotely
esac

DIR="${WEBMUX_CLIPBOARD_DIR:-/tmp/webmux-pastes}"
tmp="$DIR/.spool-$$"
printf '%s\n%s\n' "${WEBMUX_SESSION:-}" "$1" > "$tmp" 2>/dev/null || exit 4
# Rename into place so the server's watcher never reads a half-written file.
mv "$tmp" "$DIR/open-$$-$(date +%s)" 2>/dev/null || { rm -f "$tmp"; exit 4; }
exit 0
