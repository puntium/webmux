<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: the app spawns ssh, listens on unix sockets under
	     Application Support and reads the user's ~/.ssh. Hardened-runtime
	     exceptions are not needed for an ad-hoc signed debug build; the
	     stable-identity signing path (docs/signing.md) adds what it needs. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
